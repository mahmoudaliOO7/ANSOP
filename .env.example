# ANSOP Environment Configuration Template
# Copy this file to .env and customize for your environment
# NEVER commit .env to Git

# ⸻ Application Configuration

# Application mode
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Application name and version
APP_NAME=ANSOP
APP_VERSION=0.1.0

# ⸻ FastAPI Configuration

# Server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4

# CORS configuration
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ⸻ Database Configuration

# PostgreSQL connection
DATABASE_URL=postgresql://ansop_user:ansop_password_change_me@postgres:5432/ansop_db

# Connection pool
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ⸻ Authentication & Security

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-me-in-production

# Password hashing
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ⸻ Lab Configuration

# Lab mode (restricts responses to lab devices only)
LAB_MODE=true

# Dry-run mode (simulate responses without executing)
DRY_RUN=true

# Allow private network targets (lab lab devices are typically private)
ALLOW_PRIVATE_TARGETS=true

# Block external targets
BLOCK_EXTERNAL_TARGETS=true

# ⸻ Enrichment Configuration

# Threat Intelligence Providers
# For development, mock providers are used
TI_PROVIDER_TYPE=mock  # Options: mock, virustotal, abuseipdb, custom

# If using real providers, set API keys (not recommended for development)
# VIRUSTOTAL_API_KEY=your-api-key
# ABUSEIPDB_API_KEY=your-api-key

# Geolocation service (mock by default)
GEO_PROVIDER_TYPE=mock

# ⸻ Notification Configuration

# Email notifications (optional)
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=smtp-password-here
NOTIFICATION_EMAIL_FROM=ansop-system@example.com

# Slack webhook (optional)
ENABLE_SLACK_NOTIFICATIONS=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ⸻ Network Device Configuration

# Device connector type for lab network devices
DEVICE_CONNECTOR_TYPE=nornir  # Options: nornir, netmiko, mock

# Nornir inventory file (if using Nornir)
NORNIR_INVENTORY_PATH=./config/devices/nornir_inventory.yaml

# Lab network device timeout (seconds)
DEVICE_TIMEOUT=30

# ⸻ API Rate Limiting

# Detection API rate limit (requests per minute)
DETECTION_API_RATE_LIMIT=100

# General API rate limit
GENERAL_API_RATE_LIMIT=1000

# ⸻ Logging Configuration

# Log format
LOG_FORMAT=json  # Options: json, text

# Log output
LOG_OUTPUT=console  # Options: console, file, both

# Log file path (if LOG_OUTPUT includes file)
LOG_FILE_PATH=./logs/ansop.log
LOG_FILE_MAX_BYTES=10485760  # 10 MB
LOG_FILE_BACKUP_COUNT=5

# ⸻ Dashboard Configuration

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Dashboard settings
DASHBOARD_REFRESH_INTERVAL=30  # seconds
DASHBOARD_MAX_EVENTS_DISPLAY=1000

# ⸻ Audit Configuration

# Audit log retention (days)
AUDIT_LOG_RETENTION_DAYS=365

# Audit log details level
AUDIT_LOG_LEVEL=detailed  # Options: minimal, detailed, comprehensive

# ⸻ Development Configuration

# SQLAlchemy echo for SQL debugging
SQLALCHEMY_ECHO=false

# Pytest configuration (for testing)
PYTEST_WORKERS=4
PYTEST_TIMEOUT=300

# ⸻ Default Users (Development Only)

# Default admin user (created on first startup)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@ansop.local
DEFAULT_ADMIN_PASSWORD=DefaultPassword123!

# ⸻ Feature Flags

# Enable/disable features
FEATURE_APPROVAL_WORKFLOW=true
FEATURE_AUTO_RESPONSES=true
FEATURE_NETWORK_DEVICE_INTEGRATION=true
FEATURE_THREAT_INTELLIGENCE=true
FEATURE_INCIDENT_MANAGEMENT=true

# ⸻ Demo Configuration

# Demo scenario enabled
DEMO_MODE=true

# Pre-populate demo data
DEMO_DATA_ENABLED=true

# Demo lab device names (comma-separated)
DEMO_LAB_DEVICES=firewall-lab-01,router-lab-01,ids-lab-01

# ⸻ Monitoring & Observability

# Prometheus metrics (optional)
ENABLE_PROMETHEUS_METRICS=false
PROMETHEUS_PORT=9090

# Health check
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_PORT=8001

# ⸻ Session & Cache

# Session timeout (minutes)
SESSION_TIMEOUT_MINUTES=60

# Browser session idle timeout (minutes)
BROWSER_SESSION_IDLE_TIMEOUT=30

# ⸻ API Documentation

# OpenAPI documentation
ENABLE_API_DOCS=true
API_DOCS_URL=/docs
REDOC_URL=/redoc

# ⸻ Security Headers

# Strict security headers
ENABLE_SECURITY_HEADERS=true

# HSTS max age (seconds)
HSTS_MAX_AGE=31536000

# X-Frame-Options
X_FRAME_OPTIONS=DENY

# ⸻ Third-Party Services

# Sentry error tracking (optional)
SENTRY_DSN=

# ⸻ Notes

# IMPORTANT: 
# - Never commit this file with actual secrets to Git
# - Use strong, unique values for all secret keys
# - Rotate secrets regularly
# - In production, use a secrets management system (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Review all settings for your specific lab configuration
